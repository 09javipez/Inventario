# ============================================================
# VUZALO - Laravel 12 + PHP 8.2 + WireUI + Vite
# Vercel + FrankenPHP
# ============================================================

# ------------------------------------------------------------
# ETAPA 1: Dependencias PHP
# ------------------------------------------------------------
FROM dunglas/frankenphp:php8.2-bookworm AS php-dependencies

WORKDIR /app

# Extensiones necesarias para Laravel y sus paquetes
# mbstring y opcache ya vienen instaladas en FrankenPHP
RUN install-php-extensions \
    pdo_mysql \
    bcmath \
    exif \
    pcntl \
    intl \
    zip \
    gd

# Instalar Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copiar archivos de Composer
COPY composer.json composer.lock ./

# Instalar dependencias PHP
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# ------------------------------------------------------------
# ETAPA 2: Node + Vite
# ------------------------------------------------------------
FROM node:24-bookworm AS frontend

WORKDIR /app

# Copiar archivos de Node
COPY package.json package-lock.json ./

# Instalar dependencias JavaScript
RUN npm ci

# Copiar archivos necesarios para Vite
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

# WireUI necesita la carpeta vendor para Tailwind
COPY --from=php-dependencies /app/vendor ./vendor

# Compilar Vite
RUN npm run build

# ------------------------------------------------------------
# ETAPA 3: Aplicación Laravel
# ------------------------------------------------------------
FROM dunglas/frankenphp:php8.2-bookworm AS production

WORKDIR /app

# Extensiones necesarias
# mbstring y opcache ya vienen instaladas
RUN install-php-extensions \
    pdo_mysql \
    bcmath \
    exif \
    pcntl \
    intl \
    zip \
    gd

# Instalar Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copiar todo el proyecto Laravel
COPY . .

# Copiar dependencias PHP
COPY --from=php-dependencies /app/vendor ./vendor

# Copiar archivos compilados de Vite
COPY --from=frontend /app/public/build ./public/build

# ------------------------------------------------------------
# Preparar directorios de Laravel
# ------------------------------------------------------------
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# ------------------------------------------------------------
# Variables de producción
# ------------------------------------------------------------
ENV APP_ENV=production
ENV APP_DEBUG=false
ENV SERVER_NAME=:80

# Puerto HTTP
EXPOSE 80

# ------------------------------------------------------------
# Iniciar Laravel con FrankenPHP
# ------------------------------------------------------------
CMD ["sh", "-c", "frankenphp php-server --root public --listen :${PORT:-80}"]
